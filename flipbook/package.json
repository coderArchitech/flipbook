{
  "name": "flipbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-reader.mjs",
    "start": "node server/index.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "vitest run && node --test tests/document.test.mjs",
    "test:frontend": "vitest run tests/frontend",
    "test:backend": "vitest run tests/backend",
    "test:integration": "node --test tests/api.test.mjs tests/editor-api.test.mjs tests/fonts-api.test.mjs"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "express": "^5.1.0",
    "fontkit": "2.0.4",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.468.0",
    "pdfkit": "0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  }
}
